# Copy this file to .env and fill in your key to enable real Gemini extraction.
# Without a key, the backend runs in deterministic "mock" mode and still works.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the one-shot triage/chat model.
# GEMINI_MODEL=gemini-3.5-flash

# Optional Gemini Live voice settings.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Sulafat
